#!/bin/sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v py >/dev/null 2>&1; then
  PYTHON_BIN="py -3"
else
  echo "Python not found in PATH; cannot refresh docs anchors." >&2
  exit 1
fi

# Keep docs line anchors synced with source before every commit.
# shellcheck disable=SC2086
$PYTHON_BIN scripts/update-doc-anchors.py

git add docs/training-process.md docs/evaluation.md docs/plotting.md
