      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "eval",
        "--config-dir",
        "configs/delhi"
      ]
    },    {
      "name": "AQSR: Plot Dir (Delhi)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv312/Scripts/python.exe",
