    {
      "name": "AQSR: Predict (Delhi)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv312/Scripts/python.exe",
      "program": "${workspaceFolder}/.vscode/debug_entry.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "predict",
