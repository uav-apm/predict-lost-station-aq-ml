      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
